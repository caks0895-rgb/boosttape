{
  "openapi": "3.1.0",
  "info": {
    "title": "BoostTape",
    "version": "1.1.0",
    "description": "DexScreener promotion-event feed for AI agents. Returns recent boost, profile, and paid events with price reaction after the event. Promotions are not safety verification. GET /v1/events is $0.005 USDC on Base (eip155:8453) via x402, settled by a facilitator. /health stays free."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness and cache stats",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "summary": "Recent DexScreener promotion events",
        "operationId": "getEvents",
        "description": "Deduplicated boost / profile / paid events with price change after the event. Without since: unique tokens, newest first. With since: only newer events, oldest first. x402 $0.005 USDC on Base. Not financial advice.",
        "parameters": [
          {
            "name": "chain",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["solana", "base", "robinhood", "all"],
              "default": "all"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["boost", "profile", "paid", "all"],
              "default": "all"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 3, "maximum": 10, "default": 5 }
          },
          {
            "name": "min_liq",
            "in": "query",
            "schema": { "type": "number", "minimum": 0, "default": 5000 }
          },
          {
            "name": "since",
            "in": "query",
            "description": "ISO-8601 or unix seconds/ms. Only events with event_at after this timestamp. Pass next_since from the previous response.",
            "schema": { "type": "string" }
          },
          {
            "name": "since_timestamp",
            "in": "query",
            "description": "Alias of since.",
            "schema": { "type": "string" }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Alias of since.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Event tape",
            "headers": {
              "PAYMENT-RESPONSE": {
                "description": "Present after a settled x402 payment.",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EventsResponse" }
              }
            }
          },
          "400": { "description": "Invalid query" },
          "402": {
            "description": "Payment required. Read PAYMENT-REQUIRED, pay $0.005 USDC on Base, retry with PAYMENT-SIGNATURE.",
            "headers": {
              "PAYMENT-REQUIRED": {
                "description": "x402 payment required payload (base64).",
                "schema": { "type": "string" }
              }
            }
          },
          "503": { "description": "Payment rail misconfigured or facilitator unavailable." }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["ok", "as_of", "items_cached", "last_poll_ok"],
        "properties": {
          "ok": { "type": "boolean" },
          "as_of": { "type": "string", "format": "date-time" },
          "items_cached": { "type": "integer" },
          "last_poll_ok": { "type": "boolean" }
        }
      },
      "EventsResponse": {
        "type": "object",
        "required": ["as_of", "since", "next_since", "count", "disclaimer", "items"],
        "properties": {
          "as_of": { "type": "string", "format": "date-time" },
          "since": { "type": ["string", "null"], "format": "date-time" },
          "next_since": { "type": "string", "format": "date-time" },
          "count": { "type": "integer" },
          "disclaimer": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/EventItem" }
          }
        }
      },
      "EventItem": {
        "type": "object",
        "required": [
          "symbol",
          "name",
          "chain",
          "token",
          "pair",
          "dexscreener_url",
          "event",
          "event_at",
          "age_min",
          "liquidity_usd",
          "volume_24h_usd",
          "price_usd",
          "change_after",
          "flags"
        ],
        "properties": {
          "symbol": { "type": "string" },
          "name": { "type": ["string", "null"] },
          "chain": { "type": "string" },
          "token": { "type": "string" },
          "pair": { "type": ["string", "null"] },
          "dexscreener_url": { "type": "string", "format": "uri" },
          "event": { "type": "string", "enum": ["boost", "profile", "paid"] },
          "event_at": { "type": ["string", "null"], "format": "date-time" },
          "age_min": { "type": ["number", "null"] },
          "liquidity_usd": { "type": ["number", "null"] },
          "volume_24h_usd": { "type": ["number", "null"] },
          "price_usd": { "type": ["number", "null"] },
          "change_after": {
            "type": "object",
            "required": ["m5", "h1", "h6"],
            "properties": {
              "m5": { "type": ["number", "null"] },
              "h1": { "type": ["number", "null"] },
              "h6": { "type": ["number", "null"] }
            }
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "thin_lp",
                "dumped_after_boost",
                "pumped_then_flat",
                "too_new",
                "missing_price"
              ]
            }
          }
        }
      }
    }
  }
}
